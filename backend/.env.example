PORT=3000
NODE_ENV=development
MONGODB_URI=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publica del FRONT (las requests a /api llegan por el proxy). Local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Groq (LLM del agente, clase 14). Key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: cualquier modelo de Groq con tool calling
GROQ_MODEL=openai/gpt-oss-20b
